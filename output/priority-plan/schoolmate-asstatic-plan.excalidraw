–11:15   Build the highest-priority product task\n11:15–11:30   Break\n11:30–13:00   Continue the same product task\n13:00–14:00   Lunch + reset\n14:00–15:00   Asstatic offer, presentation or follow-ups\n15:00–16:00   Test, fix, teacher review or college demo\n16:00–16:15   Record result + choose tomorrow’s first task\n\nSaturday: 45-min review + optional catch-up. Sunday: rest.", "fontSize": 24, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "created": null, "labelPosition": null, "baseFontSize": null}, {"id": "plan_2ac05d2ed44f448e", "type": "text", "x": 1240, "y": 1580, "width": 685, "height": 37.5, "angle": 0, "strokeColor": "#1e293b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "index": "buR", "roundness": null, "seed": 49753461, "version": 2, "versionNonce": 50974560, "isDeleted": false, "boundElements": [], "updated": 1795159246945, "link": null, "locked": false, "customData": {"plan": "schoolmate-asstatic-nov2026"}, "text": "COMPLETION CHECKS / MAKE “DONE” VISIBLE", "originalText": "COMPLETION CHECKS / MAKE “DONE” VISIBLE", "fontSize": 30, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "created": null, "labelPosition": null, "baseFontSize": null}, {"id": "plan_e04234ff79934365", "type": "rectangle", "x": 1240, "y": 1640, "width": 1080, "height": 450, "angle": 0, "strokeColor": "#475569", "backgroundColor": "#f8fafc", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["8c55f9db943f"], "frameId": null, "index": "buS", "roundness": {"type": 3}, "seed": 838821981, "version": 2, "versionNonce": 1724208800, "isDeleted": false, "boundElements": [], "updated": 1795159246945, "link": null, "locked": false, "customData": {"plan": "schoolmate-ass