{
  "name": "@anisirji/pocket-dev",
  "version": "3.0.0",
  "description": "Self-hosted AI coding chats, authorized AI sharing, and a connected development workspace for your phone and computer.",
  "author": {
    "name": "anisirji",
    "url": "https://theani.me"
  },
  "homepage": "https://github.com/anisirji/pocket-dev#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anisirji/pocket-dev.git"
  },
  "bugs": {
    "url": "https://github.com/anisirji/pocket-dev/issues"
  },
  "license": "ISC",
  "keywords": [
    "remote-control",
    "terminal",
    "claude-code",
    "codex",
    "phone",
    "self-hosted",
    "multi-device"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.js || exit 0",
    "test": "node --test --test-concurrency=4 test/*.test.mjs",
    "start": "node server.js",
    "qr": "node scripts/qr.js",
    "admin": "node scripts/admin.js open",
    "connect": "node scripts/admin.js connect",
    "disconnect": "node scripts/admin.js disconnect",
    "autostart": "scripts/service/autostart.sh",
    "service:install": "scripts/service/install-service.sh",
    "service:uninstall": "scripts/service/uninstall-service.sh",
    "service:status": "scripts/service/status.sh",
    "service:logs": "tail -n 50 -f \"${LOG:-$HOME/Library/Logs/pocket-dev.log}\"",
    "awake": "node scripts/power/awake.js",
    "lid": "scripts/power/lid.sh",
    "sleep": "scripts/power/sleep.sh",
    "shutdown": "scripts/power/shutdown.sh",
    "build:editor": "node scripts/build-editor.js"
  },
  "type": "module",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.2.141",
    "qrcode": "^1.5.4",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "@playwright/mcp": "0.0.86",
    "node-pty": "^1.1.0",
    "web-push": "4.0.0"
  },
  "bin": {
    "pocket-dev": "bin/pocket-dev.js",
    "pocketdev-app": "bin/pocket-dev.js"
  },
  "files": [
    "bin",
    "public",
    "assets",
    "scripts",
    "server.js",
    "src",
    "README.md",
    "llms.txt",
    "skills/pocket-dev",
    "ACCESS.md",
    "docs/CHALLENGES.md",
    "docs/GUIDE.md",
    "docs/ROADMAP.md",
    "docs/REFERENCE.md",
    "docs/UNIFIED_CONNECTIONS.md",
    "docs/CAMERA.md",
    "docs/RELEASE_2.2.md",
    "docs/RELEASE_2.3.md",
    "docs/RELEASE_2.4.md",
    "docs/RELEASE_2.5.md",
    "docs/RELEASE_3.0.md",
    "docs/screenshots",
    "docs/diagrams",
    "docs/SETUP.md",
    "docs/AI_SETUP.md",
    "docs/INSTALL_BEGINNERS.md",
    "docs/windows.md",
    "docs/macos.md",
    "docs/linux.md",
    "docs/install-guide",
    "LICENSE",
    "docs/FEATURES.md",
    "docs/START_HERE.md",
    "docs/FEATURE_STANDARD.md",
    "docs/feature-catalog.json",
    "docs/media/v3"
  ],
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "engines": {
    "node": ">=22"
  },
  "contributors": [
    {
      "name": "Rohit Kumar Das",
      "url": "https://www.linkedin.com/in/rohit-kumar-das-583b28223"
    }
  ],
  "devDependencies": {
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "codemirror": "6.0.2",
    "esbuild": "0.27.7"
  }
}
