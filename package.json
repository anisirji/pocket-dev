{
  "name": "pocket-dev",
  "version": "1.0.0",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true",
    "start": "node server.js",
    "qr": "node scripts/qr.js",
    "admin": "node scripts/admin.js open",
    "connect": "node scripts/admin.js connect",
    "disconnect": "node scripts/admin.js disconnect",
    "autostart": "scripts/autostart.sh",
    "service:install": "scripts/install-service.sh",
    "service:uninstall": "scripts/uninstall-service.sh",
    "service:status": "scripts/status.sh",
    "service:logs": "tail -n 50 -f \"${LOG:-$HOME/Library/Logs/pocket-dev.log}\"",
    "awake": "node scripts/awake.js",
    "lid": "scripts/lid.sh",
    "sleep": "scripts/sleep.sh",
    "shutdown": "scripts/shutdown.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Control your Mac from your phone's browser: terminals, Claude Code and Codex chats, Git, files, open apps, and power.",
  "private": true,
  "type": "module",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.2.139",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "ws": "^8.22.1"
  },
  "bin": {
    "pocket-dev": "bin/pocket-dev.js"
  },
  "files": [
    "bin",
    "chat",
    "public",
    "scripts",
    "*.js",
    "README.md",
    "ACCESS.md",
    "docs/CHALLENGES.md",
    "docs/VALIDATION.md"
  ],
  "os": [
    "darwin"
  ],
  "engines": {
    "node": ">=22"
  }
}
