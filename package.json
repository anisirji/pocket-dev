{
  "name": "@anisirji/pocket-dev",
  "version": "1.1.1",
  "description": "Control your computer from your phone's browser: terminals, Claude Code and Codex chats, Git, files, open apps, and power.",
  "author": "anisirji",
  "license": "ISC",
  "keywords": [
    "remote-control",
    "terminal",
    "claude-code",
    "codex",
    "phone",
    "self-hosted",
    "multi-device"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "start": "node server.js",
    "qr": "node scripts/qr.js",
    "admin": "node scripts/admin.js open",
    "connect": "node scripts/admin.js connect",
    "disconnect": "node scripts/admin.js disconnect",
    "autostart": "scripts/autostart.sh",
    "service:install": "scripts/install-service.sh",
    "service:uninstall": "scripts/uninstall-service.sh",
    "service:status": "scripts/status.sh",
    "service:logs": "tail -n 50 -f \"${LOG:-$HOME/Library/Logs/pocket-dev.log}\"",
    "awake": "node scripts/awake.js",
    "lid": "scripts/lid.sh",
    "sleep": "scripts/sleep.sh",
    "shutdown": "scripts/shutdown.sh"
  },
  "type": "module",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.2.139",
    "qrcode": "^1.5.4",
    "ws": "^8.22.1"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  },
  "bin": {
    "pocket-dev": "bin/pocket-dev.js",
    "pocketdev-app": "bin/pocket-dev.js"
  },
  "files": [
    "bin",
    "chat",
    "public",
    "scripts",
    "*.js",
    "README.md",
    "ACCESS.md",
    "docs/CHALLENGES.md",
    "docs/GUIDE.md",
    "docs/REFERENCE.md",
    "docs/screenshots",
    "docs/diagrams",
    "docs/SETUP.md",
    "docs/INSTALL_BEGINNERS.md",
    "docs/install-guide",
    "LICENSE"
  ],
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "engines": {
    "node": ">=22"
  }
}
